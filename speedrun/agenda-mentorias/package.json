{
  "name": "agenda-mentorias",
  "version": "1.0.0",
  "private": true,
  "description": "Projeto inicial do Speedrun da Semana 10 · Especialização em IA · Programadores do Amanhã",
  "type": "module",
  "engines": {
    "node": ">=22.8"
  },
  "scripts": {
    "start": "node src/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test --experimental-test-coverage --test-coverage-include=\"src/**\" --test-coverage-lines=80 \"tests/**/*.test.js\"",
    "deps": "npm audit --audit-level=high",
    "smoke": "node scripts/smoke.mjs",
    "guarda": "node scripts/guarda-testes.mjs",
    "gates": "npm run lint && npm run typecheck && npm run test && npm run deps && npm run smoke && npm run guarda"
  },
  "dependencies": {
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.0",
    "eslint": "^9.39.0",
    "globals": "^16.0.0",
    "typescript": "^5.9.3"
  }
}
